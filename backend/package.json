{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for application Tips",
  "license": "ISC",
  "author": "Grondin Florent",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "ts-node src/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:build": "cd .. && docker compose build backend",
    "docker:up": "cd .. && docker compose up -d",
    "docker:down": "cd .. && docker compose down",
    "docker:restart": "cd .. && docker compose restart backend",
    "docker:logs": "cd .. && docker compose logs -f backend",
    "docker:shell": "cd .. && docker compose exec backend sh",
    "docker:prisma:push": "cd .. && docker compose exec backend npx prisma db push",
    "docker:prisma:generate": "cd .. && docker compose exec backend npx prisma generate",
    "docker:prisma:studio": "cd .. && docker compose exec backend npx prisma studio",
    "docker:seed": "cd .. && docker compose exec backend npm run seed",
    "docker:dev": "npm run docker:build && npm run docker:up && npm run docker:prisma:push && npm run docker:seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/socket.io": "^3.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.51.0"
  }
}
