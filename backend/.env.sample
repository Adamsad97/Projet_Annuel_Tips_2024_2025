PORT=3001
HOST=localhost
NODE_ENV=development

DATABASE_URL=postgresql://tips_user:tips_pass@postgres:5432/tips_db?schema=public

JWT_SECRET=change_me_jwt_secret_very_long_and_secure
REFRESH_SECRET=change_me_refresh_secret_very_long_and_secure

CORS_ORIGIN=http://localhost:3000

POSTGRES_USER=tips_user
POSTGRES_PASSWORD=tips_pass
POSTGRES_DB=tips_db
# Notifications push du navigateur (facultatif) : generer avec `npx web-push generate-vapid-keys`
# Sans ces cles, les notifications restent dans l application (cloche + temps reel)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Envoi d emails (verification d inscription)
# Par defaut en dev : Mailpit capture tous les emails, consultables sur http://localhost:8026
# En production : remplacer par le serveur SMTP du fournisseur (OVH, Brevo, Gmail...)
APP_URL=http://localhost:3000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TipsTop <no-reply@example.com>

# Recevoir les emails dans sa vraie boite (ex. Gmail) : remplacer les lignes SMTP ci-dessus par
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=votre.adresse@gmail.com
#   SMTP_PASS=mot de passe d application Google (16 caracteres, pas le mot de passe du compte)
#   MAIL_FROM=TipsTop <votre.adresse@gmail.com>
# puis : docker compose up -d --force-recreate backend
