// TIP : astuce partagée ; QUESTION : demande d'aide, les réponses passent par les commentaires
enum TipKind {
  TIP
  QUESTION
}

enum TipStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tip {
  id        Int       @id @default(autoincrement())
  title     String
  kind      TipKind   @default(TIP)
  content   String?
  address   String?
  latitude  Float?
  longitude Float?
  images    String[]  @default([])
  status    TipStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments   Comment[]
  votes      Vote[]
  views      TipsView[]
  categories TipCategory[]
  reports    Report[]      @relation("reports_on_tips")
  challengeRewards ChallengeReward[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([latitude, longitude])
}
