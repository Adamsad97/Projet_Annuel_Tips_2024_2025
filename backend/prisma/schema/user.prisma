model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  firstname            String?
  lastname             String?
  email                String    @unique
  phone                String?
  password             String
  avatarProfile        String?
  bio                  String?
  address              String?
  xp                   Int       @default(0)
  // Indice de confiance (0-100), caché à l'utilisateur, recalculé en arrière-plan
  trustIndex         Int       @default(50)
  // Décalage posé par un admin, conservé à chaque recalcul
  trustAdjustment    Int       @default(0)
  trustUpdatedAt     DateTime?
  isTwoFactorEnabled   Boolean   @default(false)
  // Sanctions : ban (connexion impossible) et mute (lecture seule) ; date de fin null = définitif
  bannedAt             DateTime?
  bannedUntil          DateTime?
  banReason            String?
  mutedUntil           DateTime?
  lastLoginAt          DateTime?
  // Secret TOTP (renseigné dès la configuration, actif seulement si isTwoFactorEnabled)
  twoFactorSecret      String?
  // Codes de secours hachés, chacun utilisable une seule fois
  twoFactorBackupCodes String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  gradeId Int?
  grade   Grade? @relation(fields: [gradeId], references: [id])

  tips       Tip[]
  comments   Comment[]
  votes      Vote[]
  views      TipsView[]
  userBadges UserBadge[]
  reports    Report[]    @relation("reports_by_user")

  moderator Moderator?
  admin     Admin?

  conversations         ConversationParticipant[]
  messages              Message[]
  moderationActions     ModerationAction[]        @relation("moderation_targets")
  moderationActionsDone ModerationAction[]        @relation("moderator_actions")
  appeals               Appeal[]                  @relation("appeals")
  appealsResolved       Appeal[]                  @relation("appeals_resolved")

  following UserSubscription[] @relation("following")
  followers UserSubscription[] @relation("followers")

  blocksMade     UserBlock[]    @relation("blocks_made")
  blocksReceived UserBlock[]    @relation("blocks_received")
  notifications  Notification[]
  categoryFollows CategoryFollow[]
  chatbotQueries  ChatbotQuery[]
}
