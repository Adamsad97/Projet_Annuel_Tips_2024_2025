enum NotificationType {
  NEW_MESSAGE
  BADGE_UNLOCKED
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  body      String?
  // Page du frontend à ouvrir au clic (ex: /messages?c=12)
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
