// Erreurs centralisées (serveur et navigateur), consultables par l'admin
model ErrorLog {
  id         Int      @id @default(autoincrement())
  // server : erreur de l'API ; client : erreur JavaScript remontée par le frontend
  source     String
  message    String
  stack      String?
  method     String?
  path       String?
  statusCode Int?
  userId     Int?
  context    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}

// Fonctionnalité expérimentale : activée pour un pourcentage stable de membres (test A/B)
model FeatureFlag {
  key                String   @id
  description        String
  enabled            Boolean  @default(true)
  rolloutPercentage  Int      @default(100)
  updatedAt          DateTime @updatedAt
}

// Message envoyé depuis le formulaire de contact, traité par un admin
model ContactMessage {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  message   String
  // Membre connecté au moment de l'envoi (facultatif)
  userId    Int?
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([handledAt, createdAt])
}
