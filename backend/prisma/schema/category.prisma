model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  tips      TipCategory[]
  followers CategoryFollow[]
  challenges SponsoredChallenge[]
}

model TipCategory {
  id         Int @id @default(autoincrement())
  tipId      Int
  categoryId Int

  tip      Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tipId, categoryId])
  @@index([tipId])
  @@index([categoryId])
}

// Catégorie suivie : notification en temps réel à chaque nouveau tip publié dedans
model CategoryFollow {
  userId     Int
  categoryId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}
