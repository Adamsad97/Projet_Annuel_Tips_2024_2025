# URL de l'API (dev : backend en direct ; production : /api derrière nginx)
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# Serveur temps réel Socket.io (dev ; laisser vide en production : même domaine)
NUXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Lien vers Adminer dans l'espace admin (développement uniquement, laisser vide en production)
NUXT_PUBLIC_ADMINER_URL=http://localhost:8080

# Adresse publique du site (liens canoniques, sitemap)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
